{
  "C_Cpp.intelliSenseEngine": "disabled",
  "stm32cube-ide-clangd.enable": true,
  "stm32cube-ide-clangd.path": ".vscode\\clangd.cmd",
  "stm32cube-ide-clangd.useScriptAsExecutable": true,
  "stm32cube-ide-clangd.fallbackFlags": [
    "--target=arm-none-eabi",
    "-mcpu=cortex-m4",
